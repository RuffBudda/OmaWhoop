#!/usr/bin/env python3
"""Fetch the latest WHOOP recovery, strain and sleep for the desktop widget.

Writes ~/.cache/whoop.json and refreshes the access token when it expires.
Exit codes: 0 ok, 1 WHOOP or the network failed (the last data is kept),
2 not connected yet (run whoop-auth first).
"""
import json, os, sys, time, urllib.error, urllib.parse, urllib.request
from datetime import datetime, timezone

CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "whoop")
CACHE = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
CLIENT, TOKENS = os.path.join(CONF, "client.json"), os.path.join(CONF, "tokens.json")
OUT = os.path.join(CACHE, "whoop.json")
API = "https://api.prod.whoop.com/developer"
TOKEN = "https://api.prod.whoop.com/oauth/oauth2/token"
USER_AGENT = "omarchy-whoop-widget/1.0"  # Cloudflare blocks the default Python-urllib agent (error 1010)


def save_tokens(tok):
    fd = os.open(TOKENS, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(tok, f)


def refresh(c, t):
    body = urllib.parse.urlencode({"grant_type": "refresh_token", "refresh_token": t["refresh_token"],
        "client_id": c["id"], "client_secret": c["secret"], "scope": "offline"}).encode()
    req = urllib.request.Request(TOKEN, data=body, headers={
        "Content-Type": "application/x-www-form-urlencoded", "User-Agent": USER_AGENT})
    new = json.load(urllib.request.urlopen(req, timeout=30))
    new.setdefault("refresh_token", t["refresh_token"])
    new["expires_at"] = time.time() + int(new.get("expires_in", 3600)) - 60
    save_tokens(new)
    return new


def latest_score(t, path):
    req = urllib.request.Request(API + path, headers={
        "Authorization": "Bearer " + t["access_token"], "User-Agent": USER_AGENT})
    recs = json.load(urllib.request.urlopen(req, timeout=30)).get("records", [])
    r = recs[0] if recs else {}
    return r.get("score") if r.get("score_state") == "SCORED" else None


def main():
    if not (os.path.exists(CLIENT) and os.path.exists(TOKENS)):
        return 2
    with open(CLIENT) as f:
        c = json.load(f)
    with open(TOKENS) as f:
        t = json.load(f)
    try:
        if time.time() >= t.get("expires_at", 0):
            t = refresh(c, t)
        rec = latest_score(t, "/v2/recovery?limit=1")
        cyc = latest_score(t, "/v2/cycle?limit=1")
        slp = latest_score(t, "/v2/activity/sleep?limit=1")
    except urllib.error.HTTPError as e:
        print(f"whoop-fetch: WHOOP answered {e.code}; keeping the last data", file=sys.stderr)
        if e.code in (400, 401):
            print("whoop-fetch: the sign-in may have expired; run whoop-auth again", file=sys.stderr)
        return 1
    except (urllib.error.URLError, OSError, ValueError) as e:
        print(f"whoop-fetch: couldn't reach WHOOP ({e}); keeping the last data", file=sys.stderr)
        return 1

    data = {
        "recovery": rec and rec.get("recovery_score"),
        "strain": cyc and cyc.get("strain"),
        "sleep": slp and slp.get("sleep_performance_percentage"),
        "updated": datetime.now(timezone.utc).isoformat(),
    }
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT + ".tmp", "w") as f:
        json.dump(data, f)
    os.replace(OUT + ".tmp", OUT)
    return 0


sys.exit(main())
